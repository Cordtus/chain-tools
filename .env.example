# Blockchain RPC Configuration
RPC_URL=http://localhost:8545
COSMOS_RPC_URL=http://localhost:26657
COSMOS_REST_URL=http://localhost:1317

# EVM Private Keys for transaction generation
PRIVATE_KEY=your_private_key_here
PRIVATE_KEY_1=your_private_key_2_here
PRIVATE_KEY_2=your_private_key_3_here
PRIVATE_KEY_3=your_private_key_4_here

# Cosmos Mnemonics for wallet generation
MNEMONIC=your 12 or 24 word mnemonic phrase here
MNEMONIC_1=second mnemonic phrase here
MNEMONIC_2=third mnemonic phrase here
MNEMONIC_3=fourth mnemonic phrase here

# Deployed Contract Addresses (automatically updated by deploy-contracts.js)
TEST_ERC20_CONTRACT=
TEST_STORAGE_CONTRACT=
TEST_COUNTER_CONTRACT=

# Configuration Notes:
# - EVM testing requires at least PRIVATE_KEY to be set
# - Cosmos testing requires at least MNEMONIC to be set
# - Deploy contracts first using: node deploy-contracts.js
# - Contract addresses will be automatically populated after deployment